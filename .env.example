# Copy to .env. Never commit .env.
POSTGRES_PASSWORD=cicd
SERVER_PUBLIC_URL=http://localhost:8080

# The server secrets below (Agents__AuthToken, Security__ApiToken, GitHub__Token, GitHub__WebhookSecret) seed the
# server's settings table on the very first start against an empty database only. Afterwards the stored row wins and
# editing them here has no effect on the server: change them at Admin -> Settings.
# AGENT_AUTH_TOKEN still configures the agent containers, so rotate the server value at Admin -> Settings first, then
# update it here and recreate the agents.
AGENT_AUTH_TOKEN=generate-a-long-random-string
AGENT_AUTO_AUTHORIZE=false
API_TOKEN=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
