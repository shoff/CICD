@page "/login"
@attribute [AllowAnonymous]
@inject IOptionsMonitor<IdentityProviderOptions> Identity

<PageTitle>Sign in - CICD</PageTitle>
<h1>Sign in</h1>
@if (!Identity.CurrentValue.IsConfigured)
{
    <p class="muted">No identity provider is configured. The server is running in open mode.</p>
}
else
{
    <AuthorizeView>
        <Authorized>
            <p>You are signed in as @context.User.Identity?.Name. <a href="@Target">Continue</a></p>
        </Authorized>
        <NotAuthorized>
            @if (Error == "invalid")
            {
                <div class="error">Sign-in failed. Check your username and password.</div>
            }
            else if (Error == "required")
            {
                <div class="error">Username and password are required.</div>
            }
            else if (Error == "unavailable")
            {
                <div class="error">The identity provider could not be reached. Try again in a moment.</div>
            }
            <form method="post" action="/login" class="login">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@Target" />
                <label>Username <input name="userName" autocomplete="username" required /></label>
                <label>Password <input name="password" type="password" autocomplete="current-password" required /></label>
                <button type="submit">Sign in</button>
            </form>
            <p class="muted small">Uses your company identity provider account.</p>
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrlQuery { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    private string Target => ReturnUrl.Sanitize(ReturnUrlQuery);
}
